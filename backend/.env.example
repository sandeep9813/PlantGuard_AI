## Required
JWT_SECRET=                           # Secret key for JWT token signing. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

## Ollama (AI Chat)
OLLAMA_MODEL=llama3.2                 # Ollama model name (default: llama3.2)
OLLAMA_BASE_URL=http://localhost:11434 # Ollama server URL (default: http://localhost:11434)
OLLAMA_TIMEOUT=60                     # HTTP timeout in seconds for Ollama requests (default: 60)

## CORS
CORS_ORIGINS=http://localhost:3000    # Comma-separated list of allowed origins (default: http://localhost:3000)

## Database
DATABASE_URL=sqlite:///./plantguard.db # Database URL (default: sqlite:///./plantguard.db)
